# Connessione al PostgreSQL locale.
# Formato: postgresql://UTENTE:PASSWORD@HOST:PORTA/NOME_DB
# Su macOS con Homebrew l'utente di default è il tuo username
# di sistema (qui "thomas") e la password è vuota.
# IMPORTANTE: l'utente va scritto esplicitamente prima di "@",
# altrimenti Prisma passa una stringa vuota e PostgreSQL
# risponde "User '' was denied access".
DATABASE_URL="postgresql://thomas@localhost:5432/chat_locale?schema=public"
